# AI Chat API — environment template.
#
# Copy to `.env` and fill in the values yourself; `.env` is gitignored and must
# never be committed. Every key is listed with an empty (or built-in) value — no
# real credentials live in this file.
#
# Anything left unset falls back to the default in `app/core/config.py`.

# --- Application -----------------------------------------------------------------

APP_NAME=AI Chat API
APP_ENV=development
LOG_LEVEL=INFO

# --- Database (Oracle, thin mode — no Oracle client libraries required) ----------

# Leave unset to use the built-in development DSN.
# DATABASE_URL=oracle+oracledb://user:password@host:1521/?service_name=service

# --- Authentication --------------------------------------------------------------

# REQUIRED in every real deployment: set a long random value. Left commented out
# it falls back to the built-in development secret. (Deliberately not written as
# `JWT_SECRET=` — an empty value would be used as the literal signing key.)
# JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- AI provider -----------------------------------------------------------------

# database | mock | openai | anthropic
# "database" resolves provider/endpoint/key/model per conversation from the DB.
AI_PROVIDER=database

# Fallback credentials, used only when AI_PROVIDER != database.
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

AI_CONTEXT_MAX_MESSAGES=50
AI_DEFAULT_CONTEXT_CHARS=16000
AI_MAX_MEMORIES=5
AI_TEMPERATURE=0.8
AI_MAX_TOKENS=1024
AI_STREAM_TIMEOUT_SECONDS=120

# --- Cloudinary (character avatar uploads) ---------------------------------------

# The browser uploads avatars straight to Cloudinary using a signature this API
# mints, so the image never passes through the API and the secret never leaves it.
#
# Cloudinary Console -> Settings -> API Keys (also shown as CLOUDINARY_URL).
# All three must be set to enable avatar uploads; left empty, the signature
# endpoint answers 503 and the app simply has no image upload.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- SMS.ir (two-step verification codes) ----------------------------------------

# https://sms.ir -> Settings -> API key. The template must be a "send verify code"
# template whose parameters are named USERNAME and CODE (see docs/otp-2fa-notes.md).
# Left empty, SMS is not configured: the OTP endpoints answer 503 and two-step
# verification cannot be enabled.
SMS_IR_API_KEY=
SMS_IR_TEMPLATE_ID=601570

# Code lifetime (seconds), minimum gap between two codes for the same user, wrong
# guesses allowed per code, and the daily cap per user. The cooldown is a security
# control: without it the attempt cap could be bypassed by requesting a new code.
OTP_CODE_TTL_SECONDS=120
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_MAX_SENDS_PER_DAY=10
